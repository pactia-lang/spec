{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pactia.io/schemas/manifests/pactia-lock.schema.json",
  "title": "pactia.lock",
  "description": "Committed dependency pins for a Pactia product workspace. See spec/docs/packages.md.",
  "type": "object",
  "required": ["packages"],
  "properties": {
    "lockVersion": {
      "type": "integer",
      "minimum": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "digest"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@[\\w-]+/[\\w-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
