{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pactia.io/schemas/manifests/pactia-package.schema.json",
  "title": "pactia.package.yaml",
  "description": "Publishable package manifest. See spec/docs/packages.md#manifest-pactiapackageyaml.",
  "type": "object",
  "required": ["name", "version", "kind"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^@[\\w-]+/[\\w-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["stack", "vertical", "protocol", "surface"]
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
