{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pactia.io/schemas/manifests/pactia-toml.schema.json",
  "title": "pactia.toml (parsed)",
  "description": "Logical shape after parsing pactia.toml. See spec/docs/packages.md. Product and package manifests use [package] name/version plus [dependencies]. Stack binding is in source (#stack_macro), not in TOML.",
  "type": "object",
  "properties": {
    "package": {
      "type": "object",
      "description": "Product or package identity (Cargo.toml [package])",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["library", "stack", "protocol", "vertical", "surface"]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "description": "Semver ranges keyed by package coordinate (@scope/name)",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocol": {
      "type": "object",
      "description": "Protocol package only — wire validation schema path",
      "properties": {
        "wireSchema": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
