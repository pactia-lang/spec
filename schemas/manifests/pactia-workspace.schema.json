{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pactia.io/schemas/manifests/pactia-workspace.schema.json",
  "title": "pactia.workspace.yaml",
  "description": "Optional workspace root manifest. See spec/docs/language-spec.md#workspace-layout.",
  "type": "object",
  "properties": {
    "workspaceVersion": {
      "type": "integer",
      "minimum": 1
    },
    "product": {
      "type": "string",
      "description": "Path to product entry file relative to workspace root",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
